rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // USUARIOS
    // ============================================================
    match /user/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ============================================================
    // SOLICITUDES DE AMISTAD
    // ============================================================
    match /friendship/{friendshipId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.solicitanteId ||
         request.auth.uid == resource.data.receptorId);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.solicitanteId &&
        request.resource.data.solicitanteId != request.resource.data.receptorId &&
        request.resource.data.estado == 'pendiente';

      allow update: if request.auth != null &&
        request.auth.uid == resource.data.receptorId &&
        request.resource.data.solicitanteId == resource.data.solicitanteId &&
        request.resource.data.receptorId == resource.data.receptorId &&
        request.resource.data.estado in ['aceptada', 'rechazada'];

      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.solicitanteId ||
         request.auth.uid == resource.data.receptorId);
    }

    // ============================================================
    // NOTIFICACIONES
    // ============================================================
    match /notification/{notificationId} {
      allow read: if request.auth != null &&
        request.auth.uid == resource.data.usuarioId;

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.origenId;

      allow update: if request.auth != null &&
        request.auth.uid == resource.data.usuarioId &&
        request.resource.data.usuarioId == resource.data.usuarioId;

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.usuarioId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}